# ==========================================
# Spicify Backend Configuration Template
# ==========================================

# Server Configuration
NODE_ENV=production
PORT=5000
API_URL=https://api.spicify.app
FRONTEND_URL=https://spicify.app

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spicify_db
DB_USER=spicify_user
DB_PASSWORD=change_me_in_production
DATABASE_URL="postgresql://spicify_user:change_me_in_production@localhost:5432/spicify_db?schema=public"

# JWT & Session Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=24h
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_in_production
REFRESH_TOKEN_EXPIRE=7d

# Symmetric Encryption Keys (used for sensitive user data & tokens)
# ENCRYPTION_KEY must be exactly 32 characters
ENCRYPTION_KEY=your_32_char_encryption_key_here
# ENCRYPTION_IV must be exactly 16 characters
ENCRYPTION_IV=your_16_char_iv_here

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# Integration API Keys
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Email (SMTP / Resend) Configuration
RESEND_API_KEY=your_resend_api_key_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ADMIN_EMAIL=admin@spicify.app
EMAIL_FROM=Spicify <onboarding@resend.dev>

# Logging Options
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# CORS and Cookie Settings
CORS_ALLOWED_ORIGINS=https://spicify.app,https://www.spicify.app
SESSION_SECRET=your_session_secret_change_in_production
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=Strict

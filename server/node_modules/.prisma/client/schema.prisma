// Production-Grade Prisma Schema for Musicfy (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  avatarUrl    String?
  bio          String?  @default("")
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  playlists         Playlist[]         @relation("UserPlaylists")
  collabPlaylists   Collaborator[]
  likes             Like[]
  history           ListeningHistory[]
  followers         Follow[]           @relation("Follower")
  following         Follow[]           @relation("Following")
  notifications     Notification[]     @relation("UserNotifications")
  sentNotifications Notification[]     @relation("ActorNotifications")
}

model Track {
  id          String   @id // YouTube Video ID
  title       String
  artistName  String
  channelId   String?
  thumbnail   String
  durationSec Int      @default(0)
  viewCount   String?
  publishedAt String?
  category    String?  @default("Music")
  createdAt   DateTime @default(now())

  likes         Like[]
  history       ListeningHistory[]
  playlistItems PlaylistTrack[]
}

model Playlist {
  id          String   @id @default(uuid())
  title       String
  description String?
  coverUrl    String?
  isPublic    Boolean  @default(true)
  isCollab    Boolean  @default(false)
  ownerId     String
  owner       User     @relation("UserPlaylists", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tracks        PlaylistTrack[]
  collaborators Collaborator[]
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlistId String
  trackId    String
  position   Int
  addedById  String?
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model Collaborator {
  id         String   @id @default(uuid())
  playlistId String
  userId     String
  joinedAt   DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playlistId, userId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model ListeningHistory {
  id          String   @id @default(uuid())
  userId      String
  trackId     String
  playedAt    DateTime @default(now())
  durationSec Int      @default(0)
  completed   Boolean  @default(false)
  skipped     Boolean  @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  actorId   String?
  type      String // LIKE, FOLLOW, COLLAB_ADD
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)
}

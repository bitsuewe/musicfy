# ==========================================
# Spicify Backend Configuration
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database Configuration
DB_HOST=db.bnfjhtaovbrdyagumumx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.bnfjhtaovbrdyagumumx
DB_PASSWORD=bwskIKPN7S6VtyIE
DATABASE_URL="postgresql://postgres.bnfjhtaovbrdyagumumx:bwskIKPN7S6VtyIE@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Password Hashing & Encryption Settings
BCRYPT_SALT_ROUNDS=12
PASSWORD_HASH_ALGORITHM=bcrypt

# JWT & Session Authentication
JWT_SECRET=spicify_production_jwt_secret_key_2026_x89a_991f_a89e
JWT_EXPIRE=24h
REFRESH_TOKEN_SECRET=spicify_production_refresh_token_secret_key_2026
REFRESH_TOKEN_EXPIRE=7d

# Symmetric Encryption Keys (used for sensitive user data & tokens)
# ENCRYPTION_KEY must be exactly 32 characters
ENCRYPTION_KEY=spicify_production_32_char_key_!
# ENCRYPTION_IV must be exactly 16 characters
ENCRYPTION_IV=spicify_16_char_iv

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=400
LOGIN_RATE_LIMIT_MAX=10
AI_CHAT_RATE_LIMIT_MAX=20
QUIZ_RATE_LIMIT_MAX=10

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email (SMTP / Resend) Configuration
RESEND_API_KEY=""
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@spicify.app
SMTP_PASSWORD=""
ADMIN_EMAIL=admin@spicify.app
EMAIL_FROM=Spicify <noreply@spicify.app>

# Admin Panel Settings
ADMIN_SECRET_KEY=spicify_admin_secret_key_2026
ADMIN_SESSION_TIMEOUT=3600

# Logging Options
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# CORS and Cookie Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_SECRET=spicify_production_session_secret_key_2026_x89a_991f
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=Lax
